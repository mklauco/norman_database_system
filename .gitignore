/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/docs
/public/storage
/.scribe
/storage/*.key
/vendor
# Environment files. Deny-by-default: every .env.* variant is ignored and
# only the committed example is allowed back in. Adding a new one (.env.staging,
# .env.local, ...) must not require remembering to update this file.
.env
.env.*
!.env.example
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json

# Keys, certificates and SSH material — must never reach a public repository.
*.pem
*.key
*.ppk
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
known_hosts

# Database dumps. Structure or data dumps describe the schema in detail and,
# for the legacy system, belong in the private internal-documentation repo.
*.sql
*.sql.gz
*.dump
!database/**/*.sql
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode

# Temporary one-off scripts (DB checks, scratch) — never commit
/_tmp

# macOS Finder metadata — never commit
.DS_Store
**/.DS_Store

# Internal working notes and legacy-system material — moved to the private
# internal-documentation repo.
# Live home: docs/migration_from_v1_v2/legacy_delta_migration/ in norman_database_system_internal_documentation.
# Anything that would describe the legacy system, prod credentials, or internal-only operational
# detail belongs there, never in this repo.

# Internal operations detail (host paths, ownership, server procedures).
# Imported by CLAUDE.md so Claude keeps the context, never published.
# Canonical copy lives in norman_database_system_internal_documentation.
.claude/ops-internal.md

# Working data directory: legacy schema dumps and internal structure notes.
# The logo and favicon assets that used to live here are the only files that
# were ever meant to be public, and they are served from public/ instead.
_data/

database/seeders/seeds/*.log
_dbdata/
_postgres_data/
_postgres_exports/
_pgadmin_data/
_secrets/*
database/seeders/seeds/ecotox_tables/ecotox_pnec3.csv

# Exclude storage directory
/storage/*

# But include templates directory
!/storage/app
!/storage/app/public
!/storage/app/public/templates
!/storage/app/public/templates/*
database/seeders/seeds/ecotox_tables/ecotox3.csv
database/seeders/seeds/literature/2025-6-20_ULEI_Wildlife_Exposure_data.csv
database/seeders/seeds/literature/DCT_BIOTA_LITERATURE_TerraChem_NILU Heimstad_2013_2023_11122025_v3.xlsx
database/seeders/seeds/literature/DCT_BIOTA_TerraChem_LiteratureData_ POPs_19102025_v1.xlsx
